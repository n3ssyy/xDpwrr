-- перетаскивание; возвращает функцию "это нажатие было перетаскиванием?"
local function makeDraggable(handle, target)
	local start, orig, moved = nil, nil, false
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			start, orig, moved = i.Position, target.Position, false
			dragFn = function(pos)
				local d = pos - start
				if d.Magnitude > 4 then moved = true end
				target.Position = UDim2.new(orig.X.Scale, orig.X.Offset + d.X, orig.Y.Scale, orig.Y.Offset + d.Y)
			end
		end
	end)
	return function() return moved end
end

