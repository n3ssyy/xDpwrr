local function C(t) return Color3.fromRGB(t[1], t[2], t[3]) end
local function A() return C(S.accent) end
local function shade(c, f) return Color3.new(c.R * f, c.G * f, c.B * f) end

local BG, SIDE = Color3.fromRGB(14, 14, 19), Color3.fromRGB(10, 10, 14)
local EL, EL2, LINE = Color3.fromRGB(21, 21, 28), Color3.fromRGB(34, 34, 45), Color3.fromRGB(48, 48, 62)
local TXT, DIM = Color3.fromRGB(226, 228, 240), Color3.fromRGB(128, 132, 150)

local conns = {}
local function bind(sig, fn)
	local c = sig:Connect(fn)
	conns[#conns + 1] = c
	return c
end

local accentFns = {}
local function onAccent(fn)
	accentFns[#accentFns + 1] = fn
	fn()
end
local function applyAccent()
	for _, fn in ipairs(accentFns) do fn() end
end

local lastErr = nil
local function safe(tag, fn)
	return function(...)
		local ok, e = pcall(fn, ...)
		if not ok then lastErr = tag .. ": " .. tostring(e) end
	end
end

