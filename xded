---------------------------------------------------------------- лого: перевёрнутый треугольник с ушками
-- треугольники собираются из горизонтальных полосок, поэтому ассеты не нужны
local function tri(parent, x, y, w, h, down, colorFn)
	local rows = math.max(2, math.floor(h / 2))
	local rh = h / rows
	local frs = {}
	for i = 0, rows - 1 do
		local f = down and (rows - i) / rows or (i + 1) / rows
		local rw = math.max(1, math.floor(w * f + 0.5))
		frs[#frs + 1] = new("Frame", {
			Size = UDim2.fromOffset(rw, math.ceil(rh)),
			Position = UDim2.fromOffset(x + math.floor((w - rw) / 2), y + math.floor(i * rh)),
			BorderSizePixel = 0,
		}, parent)
	end
	onAccent(function()
		local c = colorFn()
		for _, fr in ipairs(frs) do fr.BackgroundColor3 = c end
	end)
end

local function makeLogo(parent, s, x, y)
	local h = new("Frame", {Size = UDim2.fromOffset(s, s), Position = UDim2.fromOffset(x, y), BackgroundTransparency = 1}, parent)
	local function P(f) return math.floor(s * f + 0.5) end
	local function earCol() return shade(A(), 0.7) end
	tri(h, P(0.06), P(0.00), P(0.26), P(0.38), false, earCol)  -- левое ушко
	tri(h, P(0.68), P(0.00), P(0.26), P(0.38), false, earCol)  -- правое ушко
	tri(h, P(0.06), P(0.30), P(0.88), P(0.66), true, A)        -- большой перевёрнутый треугольник
	tri(h, P(0.33), P(0.46), P(0.34), P(0.30), true, function() return Color3.fromRGB(235, 235, 245) end)
	return h
end

