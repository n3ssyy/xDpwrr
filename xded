local tabs, activeTab = {}, nil
local togRefs = {}
local sideY = 78

local function showTab(name)
	for n, t in pairs(tabs) do
		local on = n == name
		t.btn.BackgroundTransparency = on and 0 or 1
		t.lbl.TextColor3 = on and TXT or DIM
		t.bar.Visible = on
		for sn, s in pairs(t.subs) do
			local cur = on and sn == t.cur
			s.btn.Visible = on
			s.page.Visible = cur
			s.ul.Visible = cur
			s.btn.TextColor3 = cur and TXT or DIM
			s.btn.BackgroundColor3 = cur and EL2 or EL
		end
	end
	title.Text = name
	activeTab = name
	refreshAll()
end

