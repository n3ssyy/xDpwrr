local hit = new("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5}, floatBtn)
local wasDragged = makeDraggable(hit, floatBtn)

local function toggleMenu() main.Visible = not main.Visible end
hit.MouseButton1Click:Connect(function() if not wasDragged() then toggleMenu() end end)
hideBtn.MouseButton1Click:Connect(toggleMenu)
bind(UIS.InputBegan, function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.RightShift then toggleMenu() end
end)

---------------------------------------------------------------- запуск шагов
RS:BindToRenderStep("xDpwr_cam", Enum.RenderPriority.Camera.Value + 1, safe("cam", camStep))
RS:BindToRenderStep("xDpwr_esp", Enum.RenderPriority.Camera.Value + 2, safe("esp", espStep))
RS:BindToRenderStep("xDpwr_move", Enum.RenderPriority.Character.Value + 1, safe("move", moveStep))
bind(RS.Heartbeat, worldStep)

---------------------------------------------------------------- выгрузка
local function unload()
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	pcall(function() RS:UnbindFromRenderStep("xDpwr_cam") end)
	pcall(function() RS:UnbindFromRenderStep("xDpwr_esp") end)
	pcall(function() RS:UnbindFromRenderStep("xDpwr_move") end)
	pcall(restoreMove)
	for m in pairs(objs) do removeObj(m) end
	for m in pairs(hlSet) do pcall(setHL, m, false) end
	if fovSaved then pcall(function() workspace.CurrentCamera.FieldOfView = fovSaved end) end
	-- вернуть освещение: выключаем все правила
	S.fullbright, S.noFog, S.timeOn, S.tintOn, S.ccOn, S.bloom, S.snow = false, false, false, false, false, false, false
	pcall(lightStep)
	pcall(fxStep)
	pcall(snowStep)
	if getgenv then getgenv().xDpwr = nil end
	gui:Destroy()
end
if getgenv then getgenv().xDpwr = unload end
