	end
end

---------------------------------------------------------------- visuals: мир
local saved = {}

-- если want ~= nil, держим значение; если nil, возвращаем то, что было до нас
local function lightRule(key, obj, prop, want)
	if want ~= nil then
		if obj == nil then return end
		if saved[key] == nil then saved[key] = {obj, obj[prop]} end
		if obj[prop] ~= want then obj[prop] = want end
	elseif saved[key] ~= nil then
		local o, v = saved[key][1], saved[key][2]
		if o and o.Parent then o[prop] = v end
		saved[key] = nil
	end
end

local function lightStep()
	local wBr, wSh, wAmb, wOut, wFe, wDen, wHz, wCl
	if S.fullbright then
		wBr, wSh = 2, false
		wAmb = Color3.fromRGB(178, 178, 178)
		wOut = wAmb
	end
	if S.tintOn then
		wAmb = C(S.tint)
		wOut = wAmb
	end
	if S.noFog then wFe, wDen, wHz = 9e9, 0, 0 end
	if S.timeOn then wCl = S.clock end
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	lightRule("br", Lighting, "Brightness", wBr)
	lightRule("sh", Lighting, "GlobalShadows", wSh)
	lightRule("am", Lighting, "Ambient", wAmb)
	lightRule("ou", Lighting, "OutdoorAmbient", wOut)
	lightRule("fe", Lighting, "FogEnd", wFe)
	lightRule("cl", Lighting, "ClockTime", wCl)
	lightRule("de", atm, "Density", wDen)
	lightRule("hz", atm, "Haze", wHz)
end

local cc, bl = nil, nil

local function fxStep()
	if S.ccOn then
		if not cc or not cc.Parent then
			cc = Instance.new("ColorCorrectionEffect")
			cc.Name = "xD_cc"
			cc.Parent = Lighting
		end
		cc.Saturation, cc.Contrast, cc.Brightness = S.sat, S.contrast, S.bright
	elseif cc then
		cc:Destroy()
		cc = nil
	end
	if S.bloom then
		if not bl or not bl.Parent then
			bl = Instance.new("BloomEffect")
			bl.Name = "xD_bloom"
			bl.Size, bl.Threshold = 24, 0.8
			bl.Parent = Lighting
		end
		bl.Intensity = S.bloomInt
	elseif bl then
		bl:Destroy()
		bl = nil
	end
end

-- снег: невидимая плита над камерой с ParticleEmitter (лежит в Camera, на клиенте)
local snowPart, snowEm = nil, nil

local function snowStep()
	if not S.snow then
		if snowPart then
			snowPart:Destroy()
			snowPart, snowEm = nil, nil
		end
		return
	end
	cam = workspace.CurrentCamera
	if not snowPart or not snowPart.Parent then
		snowPart = Instance.new("Part")
		snowPart.Name = "xD_snow"
		snowPart.Anchored, snowPart.CanCollide = true, false
		snowPart.CanTouch, snowPart.CanQuery, snowPart.CastShadow = false, false, false
		snowPart.Transparency = 1
		snowPart.Size = Vector3.new(110, 1, 110)
		snowEm = Instance.new("ParticleEmitter")
		snowEm.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		snowEm.EmissionDirection = Enum.NormalId.Bottom
		snowEm.Lifetime = NumberRange.new(7, 9)
		snowEm.Speed = NumberRange.new(6, 10)
		snowEm.SpreadAngle = Vector2.new(20, 20)
		snowEm.Size = NumberSequence.new(0.22)
		snowEm.Transparency = NumberSequence.new(0.1)
		snowEm.Color = ColorSequence.new(Color3.new(1, 1, 1))
		snowEm.LightEmission = 0.4
		snowEm.Rotation = NumberRange.new(0, 360)
		snowEm.RotSpeed = NumberRange.new(-60, 60)
		snowEm.Parent = snowPart
	end
	if snowPart.Parent ~= cam then snowPart.Parent = cam end
	snowPart.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, 38, 0))
	snowEm.Rate = 120 * S.snowAmt
	snowEm.Acceleration = Vector3.new(S.snowWind, 0, S.snowWind * 0.4)
end

local sLight, sFx, sSnow = safe("light", lightStep), safe("fx", fxStep), safe("snow", snowStep)

local function worldStep()
	sLight()
	sFx()
	sSnow()
end

---------------------------------------------------------------- universal + antishki (движение)
local mv = {
	char = nil, boosted = false, base = 16, fixedOn = false, preFixed = 16,
	ar = nil, neck = nil, neckC0 = nil, jit = 1, jit2 = 1,
}
local uniT = 0

local function speedStep(hum)
	-- fRtmmx: постоянная скорость, в том числе после респавна
	if S.fixed then
		if not mv.fixedOn then
			mv.fixedOn = true
			mv.preFixed = mv.boosted and mv.base or hum.WalkSpeed
			mv.boosted = false
		end
		if hum.WalkSpeed ~= S.fixedSpeed then hum.WalkSpeed = S.fixedSpeed end
		return
	elseif mv.fixedOn then
		mv.fixedOn = false
		hum.WalkSpeed = mv.preFixed
	end

	-- bhop: скорость повышается только пока ты в прыжке/падении, на земле обычная
	if S.bhop or S.bhopStrafe then
		local st = hum:GetState()
		local air = st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall
		local target = S.bhopStrafe and S.strafeSpeed or S.bhopSpeed
		if air then
			if not mv.boosted then
				mv.base = hum.WalkSpeed
				mv.boosted = true
			end
			if hum.WalkSpeed ~= target then hum.WalkSpeed = target end
		elseif mv.boosted then
			hum.WalkSpeed = mv.base
			mv.boosted = false
		end
	elseif mv.boosted then
		hum.WalkSpeed = mv.base
		mv.boosted = false
	end
end

local function yawStep(hum, root)
	if S.yawMode == 1 then
		if mv.ar ~= nil then
			hum.AutoRotate = mv.ar
			mv.ar = nil
		end
		return
	end
	if mv.ar == nil then mv.ar = hum.AutoRotate end
	hum.AutoRotate = false
	local look = cam.CFrame.LookVector
	local camYaw = math.atan2(-look.X, -look.Z)
	local pos = root.Position
	if S.yawMode == 2 then -- Spin
		root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(S.spinSpeed), 0)
	elseif S.yawMode == 3 then -- Jitter (спиной к камере, качаем влево-вправо)
		mv.jit = -mv.jit
		root.CFrame = CFrame.new(pos) * CFrame.Angles(0, camYaw + math.pi + math.rad(S.jitAngle) * mv.jit, 0)
	else -- Backwards
		root.CFrame = CFrame.new(pos) * CFrame.Angles(0, camYaw + math.pi, 0)
	end
end

local function pitchStep(c)
	if S.pitchMode == 1 then
		if mv.neck and mv.neckC0 then
			if mv.neck.Parent then mv.neck.C0 = mv.neckC0 end
			mv.neck, mv.neckC0 = nil, nil
		end
		return
	end
	local neck = c:FindFirstChild("Neck", true)
	if not (neck and neck:IsA("Motor6D")) then return end
	if mv.neck ~= neck then
		mv.neck = neck
		mv.neckC0 = neck.C0
	end
	local ang = math.rad(S.pitchAngle)
	if S.pitchMode == 2 then -- Down
		ang = -ang
	elseif S.pitchMode == 4 then -- Jitter
		mv.jit2 = -mv.jit2
		ang = ang * mv.jit2
	end
	-- вращаем вокруг оси X торса в точке шеи, поэтому работает и для R6, и для R15
	local base = mv.neckC0
	neck.C0 = CFrame.new(base.Position) * CFrame.Angles(ang, 0, 0) * (base - base.Position)
end

local function restoreMove()
	local c = lp.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if hum then
		if mv.boosted then hum.WalkSpeed = mv.base end
		if mv.fixedOn then hum.WalkSpeed = mv.preFixed end
		if mv.ar ~= nil then hum.AutoRotate = mv.ar end
	end
	if mv.neck and mv.neckC0 and mv.neck.Parent then mv.neck.C0 = mv.neckC0 end
end

local function moveStep()
	cam = workspace.CurrentCamera
	local c = lp.Character
	if c ~= mv.char then
		mv.char = c
		mv.boosted, mv.fixedOn, mv.ar, mv.neck, mv.neckC0 = false, false, nil, nil, nil
	end
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	local root = c and c:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then return end
	speedStep(hum)
	yawStep(hum, root)
	pitchStep(c)
	local now = os.clock()
