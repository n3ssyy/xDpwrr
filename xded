local crossFrame = nil

local function updateCross()
	if crossFrame then
		crossFrame:Destroy()
		crossFrame = nil
	end
	if not S.cross then return end
	crossFrame = new("Frame", {Size = UDim2.fromOffset(0, 0), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1}, gui)
	local col, g, l, t = C(S.crossColor), S.crossGap, S.crossSize, S.crossThick
	local ht = math.floor(t / 2)
	local function bar(x, y, w, h)
		new("Frame", {
			Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = col, BorderSizePixel = 0,
		}, crossFrame)
	end
	bar(-ht, -g - l, t, l) -- верх
	bar(-ht, g, t, l)      -- низ
	bar(-g - l, -ht, l, t) -- лево
	bar(g, -ht, l, t)      -- право
	if S.crossDot then bar(-ht, -ht, t, t) end
end

