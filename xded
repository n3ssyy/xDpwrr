local function toggle(parent, text, key, cb)
	local row = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = nxt(),
	}, parent)
	new("TextLabel", {
		Size = UDim2.new(1, -24, 1, 0), BackgroundTransparency = 1, Text = text, Font = Enum.Font.Gotham, TextSize = 13,
		TextColor3 = TXT, TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local box = new("Frame", {
		Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = EL2, BorderSizePixel = 0,
	}, row)
	stroke(box)
	local function refresh()
		box.BackgroundColor3 = S[key] and A() or EL2
	end
	row.MouseButton1Click:Connect(function()
		S[key] = not S[key]
		refresh()
		if cb then cb(S[key]) end
	end)
	togRefs[key] = togRefs[key] or {}
	table.insert(togRefs[key], refresh)
	refreshers[#refreshers + 1] = refresh
	onAccent(refresh)
end

local function defaultFmt(v) return tostring(math.floor(v * 100 + 0.5) / 100) end

local function slider(parent, text, min, max, step, get, set, fmt)
	fmt = fmt or defaultFmt
	local row = new("Frame", {Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = nxt()}, parent)
	new("TextLabel", {
		Size = UDim2.new(1, -54, 0, 16), BackgroundTransparency = 1, Text = text, Font = Enum.Font.Gotham, TextSize = 13,
		TextColor3 = TXT, TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local val = new("TextLabel", {
		Size = UDim2.new(0, 54, 0, 16), Position = UDim2.new(1, -54, 0, 0), BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = DIM, TextXAlignment = Enum.TextXAlignment.Right,
	}, row)
	local hit = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 16), BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
	}, row)
	local bar = new("Frame", {
		Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0.5, -2), BackgroundColor3 = EL2, BorderSizePixel = 0,
	}, hit)
	local fill = new("Frame", {Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0}, bar)
	new("Frame", {
		Size = UDim2.fromOffset(6, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}, fill)
	onAccent(function() fill.BackgroundColor3 = A() end)

	local function refresh()
		local v = get()
		fill.Size = UDim2.new(math.clamp((v - min) / (max - min), 0, 1), 0, 1, 0)
		val.Text = fmt(v)
	end
	local function setFrom(x)
		local r = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local v = min + (max - min) * r
		v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
		set(v)
		refresh()
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			setFrom(i.Position.X)
			dragFn = function(pos) setFrom(pos.X) end
		end
	end)
	refreshers[#refreshers + 1] = refresh
	refresh()
end

-- кнопка-переключатель по кругу (Off / Spin / Jitter ...)
local function selector(parent, text, opts, get, set)
	local row = new("Frame", {Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = nxt()}, parent)
	new("TextLabel", {
		Size = UDim2.new(1, -96, 1, 0), BackgroundTransparency = 1, Text = text, Font = Enum.Font.Gotham, TextSize = 13,
		TextColor3 = TXT, TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local b = new("TextButton", {
		Size = UDim2.fromOffset(92, 22), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = EL2, BorderSizePixel = 0, AutoButtonColor = false, Font = Enum.Font.GothamMedium,
		TextSize = 12, TextColor3 = TXT, Text = opts[get()],
	}, row)
	stroke(b)
	b.MouseButton1Click:Connect(function()
		local i = get() + 1
		if i > #opts then i = 1 end
		set(i)
		b.Text = opts[i]
	end)
	refreshers[#refreshers + 1] = function() b.Text = opts[get()] end
end

