---------------------------------------------------------------- выгрузка
unload = function()
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	for _, n in ipairs({"aim", "cam", "shoot", "esp", "move"}) do
		pcall(function() RS:UnbindFromRenderStep("xDpwr_" .. n) end)
	end
	pcall(restoreMove)
	for m in pairs(objs) do removeObj(m) end
	for m in pairs(hlSet) do pcall(setHL, m, false) end
	for part, o in pairs(dropObjs) do pcall(function() o:Remove() end) end
	for part in pairs(drops) do pcall(dropHL, part, false) end
	if tracer.line then pcall(function() tracer.line:Remove() end) end
	if fovSaved then pcall(function() workspace.CurrentCamera.FieldOfView = fovSaved end) end
	if zoomSaved then pcall(function() lp.CameraMaxZoomDistance = zoomSaved end) end
	-- вернуть освещение и убрать эффекты: выключаем все правила
	S.fullbright, S.noFog, S.timeOn, S.tintOn, S.gravOn = false, false, false, false, false
	S.ccOn, S.bloom, S.blur, S.sun, S.weather = false, false, false, false, 1
	pcall(lightStep)
	pcall(fxStep)
	pcall(weatherStep)
	if getgenv then getgenv().xDpwr = nil end
	gui:Destroy()
end
if getgenv then getgenv().xDpwr = unload end
