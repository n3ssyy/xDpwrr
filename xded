-- addTab("Visuals", {"Camera", "World"}) возвращает функцию: page("World") -> левая, правая колонка
local function addTab(name, subs)
	local btn = new("TextButton", {
		Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, sideY),
		BackgroundColor3 = EL, BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
	}, side)
	sideY = sideY + 32
	local lbl = new("TextLabel", {
		Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -14, 1, 0), BackgroundTransparency = 1, Text = name,
		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = DIM, TextXAlignment = Enum.TextXAlignment.Left,
	}, btn)
	local bar = new("Frame", {Size = UDim2.new(0, 2, 1, 0), BorderSizePixel = 0, Visible = false}, btn)
	onAccent(function() bar.BackgroundColor3 = A() end)

	local tab = {btn = btn, lbl = lbl, bar = bar, subs = {}, cur = subs[1]}
	tabs[name] = tab
	btn.MouseButton1Click:Connect(function() showTab(name) end)

	local x = 0
	for _, sn in ipairs(subs) do
		local w = #sn * 8 + 26
		local sb = new("TextButton", {
			Size = UDim2.fromOffset(w, 26), Position = UDim2.fromOffset(SIDE_W + 10 + x, 46), BackgroundColor3 = EL,
			BorderSizePixel = 0, Text = sn, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = DIM,
			AutoButtonColor = false, Visible = false,
		}, main)
		stroke(sb)
		local ul = new("Frame", {Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2), BorderSizePixel = 0, Visible = false}, sb)
		onAccent(function() ul.BackgroundColor3 = A() end)
		local page = new("Frame", {
			Size = UDim2.fromOffset(COLW * 2 + 10, WIN_H - PAGE_Y - 10), Position = UDim2.fromOffset(PAGE_X, PAGE_Y),
			BackgroundTransparency = 1, Visible = false,
		}, main)
		local function column(cx)
			local c = new("ScrollingFrame", {
				Size = UDim2.fromOffset(COLW, WIN_H - PAGE_Y - 10), Position = UDim2.fromOffset(cx, 0), BackgroundTransparency = 1,
				BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = LINE,
				CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			}, page)
			new("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder}, c)
			return c
		end
		tab.subs[sn] = {btn = sb, ul = ul, page = page, L = column(0), R = column(COLW + 10)}
		sb.MouseButton1Click:Connect(function()
			tab.cur = sn
			showTab(name)
		end)
		x = x + w + 4
	end
	return function(sn)
		local s = tab.subs[sn]
		return s.L, s.R
	end
end

