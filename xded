local saved = {}

-- если want ~= nil, держим значение; если nil, возвращаем то, что было до нас
local function lightRule(key, obj, prop, want)
	if want ~= nil then
		if obj == nil then return end
		if saved[key] == nil then saved[key] = {obj, obj[prop]} end
		if obj[prop] ~= want then obj[prop] = want end
	elseif saved[key] ~= nil then
		local o, v = saved[key][1], saved[key][2]
		if o and o.Parent then o[prop] = v end
		saved[key] = nil
	end
end

local function lightStep()
	local wBr, wSh, wAmb, wOut, wFe, wDen, wHz, wCl, wGr
	if S.fullbright then
		wBr, wSh = 2, false
		wAmb = Color3.fromRGB(178, 178, 178)
		wOut = wAmb
	end
	if S.tintOn then
		wAmb = C(S.tint)
		wOut = wAmb
	end
	if S.noFog then wFe, wDen, wHz = 9e9, 0, 0 end
	if S.timeOn then wCl = S.clock end
	if S.gravOn then wGr = S.gravity end
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	lightRule("br", Lighting, "Brightness", wBr)
	lightRule("sh", Lighting, "GlobalShadows", wSh)
	lightRule("am", Lighting, "Ambient", wAmb)
	lightRule("ou", Lighting, "OutdoorAmbient", wOut)
	lightRule("fe", Lighting, "FogEnd", wFe)
	lightRule("cl", Lighting, "ClockTime", wCl)
	lightRule("de", atm, "Density", wDen)
	lightRule("hz", atm, "Haze", wHz)
	lightRule("gr", workspace, "Gravity", wGr)
end

local fx = {}

-- эффект создаётся при включении и удаляется при выключении
local function fxEffect(key, class, on, setup)
	local e = fx[key]
	if on then
		if not e or not e.Parent then
			e = Instance.new(class)
			e.Name = "xD_" .. key
			e.Parent = Lighting
			fx[key] = e
		end
		setup(e)
	elseif e then
		e:Destroy()
		fx[key] = nil
	end
end

local function fxStep()
	fxEffect("cc", "ColorCorrectionEffect", S.ccOn, function(e)
		e.Saturation, e.Contrast, e.Brightness = S.sat, S.contrast, S.bright
	end)
	fxEffect("bloom", "BloomEffect", S.bloom, function(e)
		e.Intensity, e.Size, e.Threshold = S.bloomInt, 24, 0.8
	end)
	fxEffect("blur", "BlurEffect", S.blur, function(e) e.Size = S.blurSize end)
	fxEffect("sun", "SunRaysEffect", S.sun, function(e) e.Intensity, e.Spread = S.sunInt, 0.8 end)
end

-- погода: невидимая плита рядом с камерой с ParticleEmitter (лежит в Camera, на клиенте)
local wxPart, wxEm, wxMode = nil, nil, 1
local wxOffset = {nil, 38, 40, -10}
local wxRate = {nil, 120, 380, 60}

local function wxClear()
	if wxPart then wxPart:Destroy() end
	wxPart, wxEm = nil, nil
end

local function wxBuild(mode)
	wxPart = Instance.new("Part")
	wxPart.Name = "xD_weather"
	wxPart.Anchored, wxPart.CanCollide = true, false
	wxPart.CanTouch, wxPart.CanQuery, wxPart.CastShadow = false, false, false
	wxPart.Transparency = 1
	wxPart.Size = Vector3.new(110, 1, 110)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-60, 60)
	if mode == 2 then -- снег
		e.EmissionDirection = Enum.NormalId.Bottom
		e.Lifetime = NumberRange.new(7, 9)
		e.Speed = NumberRange.new(6, 10)
		e.SpreadAngle = Vector2.new(20, 20)
		e.Size = NumberSequence.new(0.22)
		e.Transparency = NumberSequence.new(0.1)
		e.Color = ColorSequence.new(Color3.new(1, 1, 1))
		e.LightEmission = 0.4
	elseif mode == 3 then -- дождь
		e.EmissionDirection = Enum.NormalId.Bottom
		e.Lifetime = NumberRange.new(1.2, 1.6)
		e.Speed = NumberRange.new(70, 90)
		e.SpreadAngle = Vector2.new(3, 3)
		e.Size = NumberSequence.new(0.3)
		e.Transparency = NumberSequence.new(0.45)
		e.Color = ColorSequence.new(Color3.fromRGB(170, 200, 255))
		e.Orientation = Enum.ParticleOrientation.VelocityParallel
		e.LightEmission = 0.1
	else -- искры, летят вверх
		e.EmissionDirection = Enum.NormalId.Top
		e.Lifetime = NumberRange.new(5, 8)
		e.Speed = NumberRange.new(3, 7)
		e.SpreadAngle = Vector2.new(35, 35)
		e.Size = NumberSequence.new(0.2)
		e.Transparency = NumberSequence.new(0.1)
		e.Color = ColorSequence.new(Color3.fromRGB(255, 140, 40))
		e.LightEmission = 1
	end
	e.Parent = wxPart
	wxEm = e
	wxMode = mode
end

local function weatherStep()
	local mode = S.weather
	if mode == 1 then
		if wxPart then wxClear() end
		return
	end
	cam = workspace.CurrentCamera
	if wxMode ~= mode or not wxPart or not wxPart.Parent then
		wxClear()
		wxBuild(mode)
	end
	if wxPart.Parent ~= cam then wxPart.Parent = cam end
	wxPart.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, wxOffset[mode], 0))
	wxEm.Rate = wxRate[mode] * S.wxAmt
	local w = S.wxWind
	if mode == 3 then w = w * 2 end
	wxEm.Acceleration = Vector3.new(w, mode == 4 and 2 or 0, w * 0.4)
end

-- прицел (Frame-ы, поэтому работает без Drawing)
local crossFrame = nil

local function updateCross()
	if crossFrame then
		crossFrame:Destroy()
		crossFrame = nil
	end
	if not S.cross then return end
	crossFrame = new("Frame", {Size = UDim2.fromOffset(0, 0), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1}, gui)
	local col, g, l, t = C(S.crossColor), S.crossGap, S.crossSize, S.crossThick
	local ht = math.floor(t / 2)
	local function bar(x, y, w, h)
		new("Frame", {
			Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = col, BorderSizePixel = 0,
		}, crossFrame)
	end
	bar(-ht, -g - l, t, l) -- верх
	bar(-ht, g, t, l)      -- низ
	bar(-g - l, -ht, l, t) -- лево
	bar(g, -ht, l, t)      -- право
	if S.crossDot then bar(-ht, -ht, t, t) end
end

