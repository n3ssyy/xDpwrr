-- Во многих играх персонажи лежат не в Player.Character, а в папках workspace.
-- Поэтому, кроме игроков, ловим любые модели с Humanoid.
local extra, drops = {}, {}

local function consider(inst)
	if inst.Name == "GunDrop" and inst:IsA("BasePart") then
		drops[inst] = true
		return
	end
	local m = nil
	if inst:IsA("Humanoid") then
		m = inst.Parent
	elseif inst:IsA("Model") and Players:FindFirstChild(inst.Name) then
		m = inst
	end
	if m and m:IsA("Model") and m ~= workspace and m.Name ~= lp.Name then
		extra[m] = true
	end
end

task.spawn(function()
	local n = 0
	for _, d in ipairs(workspace:GetDescendants()) do
		consider(d)
		n = n + 1
		if n % 3000 == 0 then task.wait() end
	end
end)
bind(workspace.DescendantAdded, consider)
bind(workspace.DescendantRemoving, function(d)
	extra[d] = nil
	if d:IsA("Humanoid") and d.Parent then extra[d.Parent] = nil end
end)

local function collect()
	local out, seen, n = {}, {}, 0
	local own = lp.Character
	for _, p in ipairs(Players:GetPlayers()) do
		local ch = p.Character
		if p ~= lp and ch and ch ~= own and not seen[ch] then
			seen[ch] = true
			n = n + 1
			out[n] = {m = ch, p = p}
		end
	end
	if S.nonPlayers or S.aimNpc then
		for m in pairs(extra) do
			if not seen[m] and m ~= own and m.Parent then
				seen[m] = true
				n = n + 1
				out[n] = {m = m, p = Players:GetPlayerFromCharacter(m)}
			end
		end
	end
	return out
end

---------------------------------------------------------------- команды, здоровье, роли MM2
local function readTeam(inst)
	if not inst then return nil end
	local a = inst:GetAttribute("Team")
	if a == nil then a = inst:GetAttribute("TeamName") end
	if a ~= nil then return a end
	local v = inst:FindFirstChild("Team")
	if v and v:IsA("ValueBase") then return v.Value end
	return nil
end

local function teamOf(m, p)
	if p and p.Team then return p.Team end
	local r = readTeam(p)
	if r == nil then r = readTeam(m) end
	return r
end

-- объект Team и строка-атрибут сравниваем по имени команды
local function teamKey(v)
	if typeof(v) == "Instance" then return v.Name end
	return v
end

-- если команду определить нельзя, считаем игрока врагом (лучше лишний, чем пропущенный)
local function sameTeam(m, p)
	local mine = teamKey(teamOf(lp.Character, lp))
	local theirs = teamKey(teamOf(m, p))
	if mine == nil or theirs == nil then return false end
	return mine == theirs
end

local function healthOf(m, hum)
	if hum then return hum.Health, hum.MaxHealth end
	local h = m:GetAttribute("Health")
	if type(h) ~= "number" then return nil, nil end
	local mh = m:GetAttribute("MaxHealth")
	if type(mh) ~= "number" or mh <= 0 then mh = 100 end
	return h, mh
end

-- MM2: у убийцы в руках или в рюкзаке Knife, у шерифа Gun, остальные невиновные
local MM2_PLACE = 142823291
local roleCache = {}

local function hasTool(box, word)
	if not box then return false end
	for _, it in ipairs(box:GetChildren()) do
		if it:IsA("Tool") and string.find(string.lower(it.Name), word, 1, true) then return true end
	end
	return false
end

local function roleOf(p)
	local r = roleCache[p]
	if r then return r end
	local bp = p:FindFirstChildOfClass("Backpack")
	r = "Innocent"
	if hasTool(p.Character, "knife") or hasTool(bp, "knife") then
		r = "Murderer"
	elseif hasTool(p.Character, "gun") or hasTool(bp, "gun") then
		r = "Sheriff"
	end
	roleCache[p] = r
	return r
end

local function roleCol(r)
	if r == "Murderer" then return C(S.cMurd) end
	if r == "Sheriff" then return C(S.cSher) end
	return C(S.cInno)
end

-- кого можно выбирать целью в режиме MM2
local function mm2Allowed(p)
	if not S.mm2 or not p then return true end
	local role = roleOf(p)
	if S.mm2Aim == 4 then return true end
	if S.mm2Aim == 2 then return role == "Murderer" end
	if S.mm2Aim == 3 then return role == "Sheriff" end
	-- Auto: убийца бьёт всех, остальные целятся только в убийцу
	if roleOf(lp) == "Murderer" then return role ~= "Murderer" end
	return role == "Murderer"
end

---------------------------------------------------------------- ESP: объекты рисования
local objs, hlSet, dropObjs = {}, {}, {}
local hlCount = 0

local function newObj()
	local d = {bones = {}}
	for i = 1, #bones do
		local l = Drawing.new("Line")
		l.Visible = false
		d.bones[i] = l
	end
	d.box = Drawing.new("Square")
	d.box.Filled = false
	d.box.Visible = false
	d.tracer = Drawing.new("Line")
	d.tracer.Visible = false
	d.hp = Drawing.new("Line")
	d.hp.Visible = false
	d.a1 = Drawing.new("Line")
	d.a1.Visible = false
	d.a2 = Drawing.new("Line")
	d.a2.Visible = false
	d.name = Drawing.new("Text")
	d.dist = Drawing.new("Text")
	for _, t in ipairs({d.name, d.dist}) do
		t.Center, t.Outline, t.Size, t.Visible = true, true, 13, false
	end
	local okc, circ = pcall(Drawing.new, "Circle")
	if okc and circ then
		circ.Filled, circ.Visible, circ.NumSides = false, false, 12
		d.head = circ
	end
	return d
end

local function hideObj(d)
	for _, l in ipairs(d.bones) do l.Visible = false end
	d.box.Visible = false
	d.tracer.Visible = false
	d.hp.Visible = false
	d.a1.Visible = false
	d.a2.Visible = false
	d.name.Visible = false
	d.dist.Visible = false
	if d.head then d.head.Visible = false end
end

local function removeObj(m)
	local d = objs[m]
	if not d then return end
	for _, l in ipairs(d.bones) do pcall(function() l:Remove() end) end
	for _, k in ipairs({"box", "tracer", "hp", "a1", "a2", "name", "dist", "head"}) do
		pcall(function() d[k]:Remove() end)
	end
	objs[m] = nil
end

-- chams: контур + заливка через Highlight (работает и без Drawing)
local function setHL(m, on, col)
	local h = m:FindFirstChild("xD_hl")
	if on then
		if not h then
			h = Instance.new("Highlight")
			h.Name = "xD_hl"
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Parent = m
			hlSet[m] = true
		end
		h.FillColor, h.OutlineColor = col, col
		h.FillTransparency, h.OutlineTransparency = S.chamsFill, 0
	elseif h then
		h:Destroy()
		hlSet[m] = nil
	end
end

-- стрелка у края экрана для цели, которой не видно
local function drawArrow(d, pos, col, vp)
	local rel = cam.CFrame:PointToObjectSpace(pos)
	local dx, dy = rel.X, rel.Z -- вперёд (-Z) = вверх по экрану
	local len = math.sqrt(dx * dx + dy * dy)
	if len < 1e-3 then return end
	dx, dy = dx / len, dy / len
	local cx, cy, r = vp.X / 2, vp.Y / 2, S.arrowRadius
	local tx, ty = cx + dx * (r + 12), cy + dy * (r + 12)
	local bx, by = cx + dx * r, cy + dy * r
	local px, py = -dy * 8, dx * 8
	d.a1.From, d.a1.To = Vector2.new(tx, ty), Vector2.new(bx + px, by + py)
	d.a2.From, d.a2.To = Vector2.new(tx, ty), Vector2.new(bx - px, by - py)
	d.a1.Color, d.a2.Color = col, col
	d.a1.Thickness, d.a2.Thickness = 2, 2
	d.a1.Visible, d.a2.Visible = true, true
end

local function drawTarget(t, col, camPos, vp)
	local m, p = t.m, t.p
	local hum = m:FindFirstChildOfClass("Humanoid")
	local root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChild("Torso")
		or m:FindFirstChild("UpperTorso") or m:FindFirstChildWhichIsA("BasePart")
	if not root then return false end
	local head = m:FindFirstChild("Head") or root
	local hp, mhp = healthOf(m, hum)
	if hp and hp <= 0 then return false end
	local dist = (root.Position - camPos).Magnitude
	if dist > S.maxDist then return false end
	if S.team and sameTeam(m, p) then return false end

	-- MM2: цвет и подпись по роли
	local role = nil
	if S.mm2 and p then
		role = roleOf(p)
		if role == "Innocent" and not S.mm2Innocents then return false end
		col = roleCol(role)
	end

	-- без Drawing chams включаются сами, иначе ESP вообще ничего не покажет
	if S.chams or not hasDrawing then
		if hlCount < 30 then
			hlCount = hlCount + 1
			setHL(m, true, col)
		end
	else
		setHL(m, false)
	end
	if not hasDrawing then return true end

	local d = objs[m]
	if not d then
		d = newObj()
		objs[m] = d
	end

	local rp, onScreen = cam:WorldToViewportPoint(root.Position)
	if not onScreen then
		hideObj(d)
		if S.arrows then drawArrow(d, root.Position, col, vp) end
		return true
	end
	d.a1.Visible, d.a2.Visible = false, false
	local topP = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.8, 0))
	local botP = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3.2, 0))
	local h = math.abs(botP.Y - topP.Y)
	local w = h * 0.55

	for i, pair in ipairs(bones) do
		local ln = d.bones[i]
		local a, b = nil, nil
		if S.skeleton then
			a, b = m:FindFirstChild(pair[1]), m:FindFirstChild(pair[2])
		end
		if a and b then
			local pa, va = cam:WorldToViewportPoint(a.Position)
			local pb, vb = cam:WorldToViewportPoint(b.Position)
			ln.From, ln.To = Vector2.new(pa.X, pa.Y), Vector2.new(pb.X, pb.Y)
			ln.Color, ln.Thickness = col, S.thick
			ln.Visible = va and vb
		else
			ln.Visible = false
		end
	end

	local bx = d.box
	if S.box then
		bx.Size = Vector2.new(w, h)
		bx.Position = Vector2.new(rp.X - w / 2, topP.Y)
		bx.Color, bx.Thickness, bx.Visible = col, S.thick, true
	else
		bx.Visible = false
	end

	local hd = d.head
	if hd then
		if S.headDot then
			local hpos = cam:WorldToViewportPoint(head.Position)
			hd.Position = Vector2.new(hpos.X, hpos.Y)
			hd.Radius = math.max(2, h * 0.07)
			hd.Color, hd.Thickness, hd.Visible = col, S.thick, true
		else
			hd.Visible = false
		end
	end

	local tr = d.tracer
	if S.tracers then
		local oy = vp.Y
		if S.tracerOrigin == 2 then oy = vp.Y / 2 elseif S.tracerOrigin == 3 then oy = 0 end
		tr.From, tr.To = Vector2.new(vp.X / 2, oy), Vector2.new(rp.X, botP.Y)
		tr.Color, tr.Thickness, tr.Visible = col, 1, true
	else
		tr.Visible = false
	end

	local nm = d.name
	if S.name then
		local label = p and p.Name or m.Name
		if role then label = label .. " [" .. role .. "]" end
		if S.healthText and hp then label = label .. " " .. math.floor(hp) .. "HP" end
		nm.Text = label
		nm.Position = Vector2.new(rp.X, topP.Y - 16)
		nm.Color, nm.Visible = col, true
	else
		nm.Visible = false
	end

	local ds = d.dist
	if S.dist then
		ds.Text = "[" .. math.floor(dist) .. "m]"
		ds.Position = Vector2.new(rp.X, botP.Y + 2)
		ds.Color, ds.Visible = col, true
	else
		ds.Visible = false
	end

	local hb = d.hp
	if S.health and hp and mhp and mhp > 0 then
		local r = math.clamp(hp / mhp, 0, 1)
		local x = rp.X - w / 2 - 5
		hb.From, hb.To = Vector2.new(x, botP.Y), Vector2.new(x, botP.Y - h * r)
		hb.Color, hb.Thickness, hb.Visible = Color3.fromHSV(r * 0.33, 1, 1), 2, true
	else
		hb.Visible = false
	end
	return true
end

-- MM2: подсветка выпавшего пистолета (GunDrop)
local function dropHL(part, on)
	local h = part:FindFirstChild("xD_drop")
	if on and not h then
		h = Instance.new("Highlight")
		h.Name = "xD_drop"
		h.FillColor = Color3.fromRGB(255, 215, 80)
		h.OutlineColor = Color3.new(1, 1, 1)
		h.FillTransparency = 0.4
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Parent = part
	elseif not on and h then
		h:Destroy()
	end
end

local function dropsStep()
	local on = S.mm2 and S.mm2Drops
	for part in pairs(drops) do
		local o = dropObjs[part]
		if not part.Parent then
			drops[part] = nil
			if o then
				pcall(function() o:Remove() end)
				dropObjs[part] = nil
			end
		elseif on then
			dropHL(part, true)
			if hasDrawing then
				if not o then
					o = Drawing.new("Text")
					o.Text, o.Center, o.Outline, o.Size = "Gun", true, true, 15
					o.Color = Color3.fromRGB(255, 215, 80)
					dropObjs[part] = o
				end
				local sp, vis = cam:WorldToViewportPoint(part.Position + Vector3.new(0, 1.5, 0))
				o.Position = Vector2.new(sp.X, sp.Y)
				o.Visible = vis
			end
		else
			dropHL(part, false)
			if o then o.Visible = false end
		end
	end
end

local EMPTY = {}
local curList = EMPTY
local espWasOn, statusT = false, 0
local seenFrame = {}

local function refreshList()
	for k in pairs(roleCache) do roleCache[k] = nil end
	if S.esp or S.aim or S.shoot then curList = collect() else curList = EMPTY end
end

local function espStep()
	cam = workspace.CurrentCamera
	dropsStep()
	if not S.esp then
		if espWasOn then
			espWasOn = false
			for _, d in pairs(objs) do hideObj(d) end
			for m in pairs(hlSet) do setHL(m, false) end
		end
		return
	end
	espWasOn = true
	local col = C(S.espColor)
	local camPos, vp = cam.CFrame.Position, cam.ViewportSize
	local list = curList
	for k in pairs(seenFrame) do seenFrame[k] = nil end
	hlCount = 0

	local shown = 0
	for i = 1, #list do
		if S.nonPlayers or list[i].p then
			local ok, res = pcall(drawTarget, list[i], col, camPos, vp)
			if ok then
				if res then
					seenFrame[list[i].m] = true
					shown = shown + 1
				end
			else
				lastErr = "esp: " .. tostring(res)
			end
		end
	end

	-- всё, что не показали в этом кадре, прячем; мёртвые модели удаляем
	for m, d in pairs(objs) do
		if not seenFrame[m] then
			hideObj(d)
			if not m:IsDescendantOf(game) then removeObj(m) end
		end
	end
	for m in pairs(hlSet) do
		if not seenFrame[m] then setHL(m, false) end
	end

	local now = os.clock()
	if statusLbl and now - statusT > 0.4 then
		statusT = now
		statusLbl.Text = string.format("Found: %d  Shown: %d\nDrawing: %s\nMy team: %s\nErr: %s",
			#list, shown, hasDrawing and "yes" or "NO (chams)", tostring(teamOf(lp.Character, lp)),
			lastErr or "none")
	end
end

---------------------------------------------------------------- аимбот и автошут
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function visibleTo(pos, m)
	local origin = cam.CFrame.Position
	local filter = {cam}
	if lp.Character then filter[2] = lp.Character end
	rayParams.FilterDescendantsInstances = filter
	local hit = workspace:Raycast(origin, pos - origin, rayParams)
	return hit == nil or hit.Instance:IsDescendantOf(m)
end

local nearestNames = {
	"Head", "UpperTorso", "LowerTorso", "Torso", "HumanoidRootPart", "LeftUpperArm", "RightUpperArm",
	"LeftUpperLeg", "RightUpperLeg", "Left Arm", "Right Arm", "Left Leg", "Right Leg",
}

local function partFor(m, mode, origin)
	local head = m:FindFirstChild("Head")
	local chest = m:FindFirstChild("UpperTorso") or m:FindFirstChild("Torso")
	local root = m:FindFirstChild("HumanoidRootPart")
	if mode == 1 then return head or chest or root end
	if mode == 2 then return chest or root or head end
	if mode == 3 then return root or chest or head end
	local best, bd = nil, nil
	for _, n in ipairs(nearestNames) do
		local pt = m:FindFirstChild(n)
		if pt and pt:IsA("BasePart") then
			local sp, on = cam:WorldToViewportPoint(pt.Position)
			if on then
				local dd = (Vector2.new(sp.X, sp.Y) - origin).Magnitude
				if not bd or dd < bd then best, bd = pt, dd end
			end
		end
	end
	return best or head or chest or root
end

-- упреждение: скорость цели * (пинг + время полёта снаряда)
local function predictPos(part, dist)
	local t = S.predictMs / 1000
	if S.projSpeed > 0 then t = t + dist / S.projSpeed end
	return part.Position + part.AssemblyLinearVelocity * t
end

local function candidate(t, origin, fovR, usePredict)
	local m, p = t.m, t.p
	if not p and not S.aimNpc then return nil end
	local hum = m:FindFirstChildOfClass("Humanoid")
	local hp = healthOf(m, hum)
	if hp and hp <= 0 then return nil end
	if S.aimTeam and sameTeam(m, p) then return nil end
	if not mm2Allowed(p) then return nil end
	local part = partFor(m, S.aimPart, origin)
	if not part then return nil end
	local dist = (part.Position - cam.CFrame.Position).Magnitude
	if dist > S.aimMax then return nil end
	local pos = part.Position
	if usePredict then pos = predictPos(part, dist) end
	local sp, on = cam:WorldToViewportPoint(pos)
	if not on then return nil end
	local spv = Vector2.new(sp.X, sp.Y)
	local sd = (spv - origin).Magnitude
	if sd > fovR then return nil end
	if S.aimVis and not visibleTo(part.Position, m) then return nil end
	local score = sd
	if S.aimPrio == 2 then score = dist elseif S.aimPrio == 3 then score = hp or 100 end
	return {m = m, p = p, part = part, pos = pos, sp = spv, dist = dist, score = score}
end

local lockM = nil

local function pickTarget(origin, fovR, usePredict)
	if S.sticky and lockM then
		for i = 1, #curList do
			if curList[i].m == lockM then
				local c = candidate(curList[i], origin, fovR * 2, usePredict)
				if c then return c end
			end
		end
	end
	local best = nil
	for i = 1, #curList do
		local c = candidate(curList[i], origin, fovR, usePredict)
		if c and (not best or c.score < best.score) then best = c end
	end
	return best
end

local function holding(mode)
	if mode == 1 then return true end
	if mode == 2 then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
	return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
end

local aimOrigin = Vector2.new(0, 0)
local aimInfo = {tgt = nil}
local fovFrame, fovStroke = nil, nil

local function updateFov(origin)
	if not (S.fovShow and (S.aim or S.shoot)) then
		if fovFrame then fovFrame.Visible = false end
		return
	end
	if not fovFrame then
		fovFrame = new("Frame", {
			BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, ZIndex = 4,
		}, gui)
		new("UICorner", {CornerRadius = UDim.new(1, 0)}, fovFrame)
		fovStroke = stroke(fovFrame)
	end
	local d = S.aimFov * 2
	fovFrame.Visible = true
	fovFrame.Size = UDim2.fromOffset(d, d)
	fovFrame.Position = UDim2.fromOffset(origin.X, origin.Y)
	fovStroke.Color, fovStroke.Thickness = C(S.fovCol), S.fovThick
end

local function aimStep()
	cam = workspace.CurrentCamera
	refreshList()
	local vp = cam.ViewportSize
	local origin = Vector2.new(vp.X / 2, vp.Y / 2)
	if S.fovFollow == 2 then origin = UIS:GetMouseLocation() end
	aimOrigin = origin
	updateFov(origin)
	aimInfo.tgt = nil
	lockM = nil
	if S.aim and holding(S.aimHold) then
		local t = pickTarget(origin, S.aimFov, S.predict)
		if t then
			aimInfo.tgt = t
			lockM = t.m
			local cur = cam.CFrame
			local alpha = math.clamp(1 - S.aimSmooth / 100, 0.02, 1)
			cam.CFrame = cur:Lerp(CFrame.lookAt(cur.Position, t.pos), alpha)
		end
	end
end

-- автошут: имитируем клик мыши или касание в точке, где стоит цель
local sh = {tgt = nil, since = 0, last = 0, flashUntil = 0, flashPos = nil, shots = 0, method = "-"}
local tracer = {line = nil, mark = nil, markStroke = nil}
local aimT = 0

local function overMenu(x, y)
	if not (main and main.Visible) then return false end
	local p, s = main.AbsolutePosition, main.AbsoluteSize
	return x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y
end

local function clickAt(x, y)
	local touch = S.shootMode == 3 or (S.shootMode == 1 and UIS.TouchEnabled and not UIS.MouseEnabled)
	if touch and VIM then
		pcall(function() VIM:SendTouchEvent(77, 0, x, y) end)
		task.delay(0.03, function() pcall(function() VIM:SendTouchEvent(77, 2, x, y) end) end)
		return "touch"
	end
	local back = nil
	if S.shootMove and mousemoveabs then
		back = UIS:GetMouseLocation()
		pcall(mousemoveabs, x, y)
	end
	local how = nil
	if mouse1click then
		pcall(mouse1click)
		how = "mouse1click"
	elseif VIM then
		pcall(function() VIM:SendMouseButtonEvent(x, y, 0, true, game, 1) end)
		task.delay(0.03, function() pcall(function() VIM:SendMouseButtonEvent(x, y, 0, false, game, 1) end) end)
		how = "VIM mouse"
	end
	if back and S.shootRestore then
		task.delay(0.05, function() pcall(mousemoveabs, back.X, back.Y) end)
	end
	return how
end

local function hasToolInHand()
	local c = lp.Character
	return c ~= nil and c:FindFirstChildOfClass("Tool") ~= nil
end

local function tracerStep(t, now, vp)
	if not tracer.mark then
		tracer.mark = new("Frame", {
			Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
			BorderSizePixel = 0, ZIndex = 4, Visible = false,
		}, gui)
		tracer.markStroke = stroke(tracer.mark)
	end
	if hasDrawing and not tracer.line then
		tracer.line = Drawing.new("Line")
		tracer.line.Visible = false
	end
	local pos = nil
	if t then pos = t.sp elseif now < sh.flashUntil then pos = sh.flashPos end
	if not (S.tracer and pos) then
		tracer.mark.Visible = false
		if tracer.line then tracer.line.Visible = false end
		return
	end
	local flash = now < sh.flashUntil
	local col = flash and Color3.new(1, 1, 1) or C(S.tracerCol)
	local sz = flash and 18 or 10
	tracer.mark.Size = UDim2.fromOffset(sz, sz)
	tracer.mark.Position = UDim2.fromOffset(pos.X, pos.Y)
	tracer.mark.Visible = true
	tracer.markStroke.Color = col
	if tracer.line then
		tracer.line.From, tracer.line.To = Vector2.new(vp.X / 2, vp.Y), pos
		tracer.line.Color, tracer.line.Thickness, tracer.line.Visible = col, 1.5, true
	end
end

local function shootStep()
	cam = workspace.CurrentCamera
	local now = nowMs()
	local vp = cam.ViewportSize
	local t = nil
	if S.shoot and holding(S.shootHold) and (not S.shootNeedTool or hasToolInHand()) then
		t = pickTarget(aimOrigin, S.aimFov, S.shootPredict)
	end
	if t then
		if sh.tgt ~= t.m then
			sh.tgt = t.m
			sh.since = now
		end
	else
		sh.tgt = nil
	end
	tracerStep(t, now, vp)
	if t and now - sh.since >= S.shootDelay and now - sh.last >= S.shootInt and not overMenu(t.sp.X, t.sp.Y) then
		sh.last = now
		sh.flashUntil = now + S.tracerMs
		sh.flashPos = t.sp
		sh.shots = sh.shots + 1
		sh.method = clickAt(t.sp.X, t.sp.Y) or "no click API"
	end
	local sec = os.clock()
	if aimLbl and sec - aimT > 0.3 then
		aimT = sec
		local tg = aimInfo.tgt or t
		aimLbl.Text = string.format("Target: %s\nShots: %d\nLast click: %s\nDevice: %s",
			tg and (tg.p and tg.p.Name or tg.m.Name) or "-", sh.shots, sh.method,
			(UIS.TouchEnabled and not UIS.MouseEnabled) and "touch" or "mouse")
	end
end

