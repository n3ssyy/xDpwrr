local CFG = "xDpwr.json"

local function cfgSave()
	local ok = pcall(function() writefile(CFG, HttpService:JSONEncode(S)) end)
	toast(ok and "Config saved" or "Save failed (no writefile)")
end

local function cfgLoad()
	local ok = pcall(function()
		local d = HttpService:JSONDecode(readfile(CFG))
		for k, v in pairs(d) do
			local cur = S[k]
			if type(cur) == "table" and type(v) == "table" then
				for i = 1, #cur do
					if type(v[i]) == "number" then cur[i] = v[i] end
				end
			elseif cur ~= nil and type(cur) == type(v) then
				S[k] = v
			end
		end
	end)
	refreshAll()
	applyAccent()
	updateCross()
	toast(ok and "Config loaded" or "Load failed (no file)")
end

